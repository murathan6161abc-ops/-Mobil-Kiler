# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. .env dosyası git'e eklenmez.

# Google AI Studio'dan alınan Gemini API anahtarı (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Doluysa mobil uygulama her istekte bu anahtarı "X-API-Key" başlığıyla göndermelidir.
# Uygulamada: Ayarlar > API anahtarı. Aynı ağdaki yabancıların verinizi silmesini engeller.
APP_API_KEY=

# Varsayılan: backend/inventory.db (SQLite). PostgreSQL örneği:
# DATABASE_URL=postgresql://kullanici:sifre@sunucu/veritabani
DATABASE_URL=

# "Bugün"ün hesaplandığı saat dilimi
APP_TIMEZONE=Europe/Istanbul

# Tarayıcıdan (Flutter web) erişime izin verilen adresler, virgülle ayrılmış. * = hepsi
CORS_ORIGINS=*

# Yapay zekâ uç noktaları için IP başına dakikalık istek sınırı (0 = sınırsız)
AI_RATE_LIMIT_PER_MINUTE=10

# Barkoddan ürün adı bulmak için Open Food Facts kullanılsın mı (1/0)
OPEN_FOOD_FACTS_ENABLED=1
